<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ======================================================== -->
        <!-- >>> MENÚ SUPERIOR CON HORIZONTAL SCROLL (sin saltos de línea) <<< -->
        <!-- ======================================================== -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#E0E0E0"
                android:padding="8dp"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/tabCarnes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carnes"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:background="@drawable/tab_selected_bg"
                    android:textColor="@android:color/white" />

                <TextView
                    android:id="@+id/tabBebidas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bebidas"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:background="@drawable/tab_unselected_bg"
                    android:textColor="#333333" />

                <TextView
                    android:id="@+id/tabPescados"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pescados"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:background="@drawable/tab_unselected_bg"
                    android:textColor="#333333" />

                <TextView
                    android:id="@+id/tabPostres"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Postres"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:background="@drawable/tab_unselected_bg"
                    android:textColor="#333333" />

                <TextView
                    android:id="@+id/tabCarrito"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carrito"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:background="@drawable/tab_unselected_bg"
                    android:textColor="#333333" />

            </LinearLayout>

        </HorizontalScrollView>
        <!-- ======================================================== -->
        <!-- >>> FIN DEL MENÚ SUPERIOR <<< -->
        <!-- ======================================================== -->

        <!-- Título de la sección -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipos de Carnes:"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#005A87"
            android:layout_marginBottom="16dp" />

        <!-- Lista de productos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/itemBurguer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Burguers"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@color/dark_blue"
                android:gravity="center"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:backgroundTint="@color/dark_blue" />

            <TextView
                android:id="@+id/itemPluma"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pluma Ibérica"
                android:textSize="16sp"
                android:textColor="#333333"
                android:background="@drawable/rounded_item_bg"
                android:gravity="center"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/itemPechuga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pechuga"
                android:textSize="16sp"
                android:textColor="#333333"
                android:background="@drawable/rounded_item_bg"
                android:gravity="center"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/itemSolomillo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Solomillo"
                android:textSize="16sp"
                android:textColor="#333333"
                android:background="@drawable/rounded_item_bg"
                android:gravity="center"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/itemCachopo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cachopo"
                android:textSize="16sp"
                android:textColor="#333333"
                android:background="@drawable/rounded_item_bg"
                android:gravity="center"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/itemAlitas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alitas"
                android:textSize="16sp"
                android:textColor="#333333"
                android:background="@drawable/rounded_item_bg"
                android:gravity="center"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/itemPato"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pato"
                android:textSize="16sp"
                android:textColor="#333333"
                android:background="@drawable/rounded_item_bg"
                android:gravity="center"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>