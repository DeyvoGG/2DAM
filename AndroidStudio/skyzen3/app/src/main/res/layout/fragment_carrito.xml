<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ======================================================== -->
        <!-- >>> MENÚ SUPERIOR CON HORIZONTAL SCROLL <<< -->
        <!-- ======================================================== -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#E0E0E0"
                android:padding="8dp"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/tabCarnes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carnes"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:background="@drawable/tab_unselected_bg"
                    android:textColor="#333333" />

                <TextView
                    android:id="@+id/tabBebidas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bebidas"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:background="@drawable/tab_unselected_bg"
                    android:textColor="#333333" />

                <TextView
                    android:id="@+id/tabPescados"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pescados"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:background="@drawable/tab_unselected_bg"
                    android:textColor="#333333" />

                <TextView
                    android:id="@+id/tabPostres"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Postres"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:background="@drawable/tab_unselected_bg"
                    android:textColor="#333333" />

                <TextView
                    android:id="@+id/tabCarrito"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carrito"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:background="@drawable/tab_selected_bg"
                    android:textColor="@android:color/white" />

            </LinearLayout>

        </HorizontalScrollView>
        <!-- ======================================================== -->
        <!-- >>> FIN DEL MENÚ SUPERIOR <<< -->
        <!-- ======================================================== -->

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tu Carrito"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#005A87"
            android:layout_marginBottom="16dp" />

        <!-- Contenido del carrito -->
        <LinearLayout
            android:id="@+id/cartItemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <!-- Ítem de ejemplo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/rounded_item_bg"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Burguers"
                    android:textSize="16sp"
                    android:textColor="#333333" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="x1"
                    android:textSize="16sp"
                    android:textColor="#005A87"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/rounded_item_bg"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Agua"
                    android:textSize="16sp"
                    android:textColor="#333333" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="x2"
                    android:textSize="16sp"
                    android:textColor="#005A87"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Botones inferiores -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnClearCart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Vaciar"
                android:textSize="14sp"
                android:backgroundTint="#FF6B6B"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/btnConfirmOrder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Confirmar"
                android:textSize="14sp"
                android:backgroundTint="@color/dark_blue"
                android:textColor="@android:color/white" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>