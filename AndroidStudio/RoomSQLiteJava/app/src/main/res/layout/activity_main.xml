<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gestión de Tareas"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btnUsuarios"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="Gestionar Usuarios"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnCategorias"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="Gestionar Categorías"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnTareas"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="Gestionar Tareas"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnListaUsuarios"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="Ver Lista de Usuarios"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnListaCategorias"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="Ver Lista de Categorías"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnListaTareas"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="Ver Lista de Tareas"
            android:layout_marginBottom="12dp"/>

    </LinearLayout>
</ScrollView>